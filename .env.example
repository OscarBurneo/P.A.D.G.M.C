# Copie este archivo a .env y cambie los valores. No suba .env al repositorio.
# Los parámetros marcados como pendiente de aprobación son propuestas, no un acuerdo del cliente.

# Base de datos (P-07, entorno todavía no elegido)
POSTGRES_USER=padgmc
POSTGRES_PASSWORD=cambiar-esto
POSTGRES_DB=padgmc
BASE_DATOS_URL=postgresql+psycopg://padgmc:cambiar-esto@localhost:5432/padgmc

# desarrollo | prueba | produccion
# En produccion la cookie es Secure y el inicio de sesión exige HTTPS.
ENTORNO=desarrollo
CONFIAR_PROXY=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGENES=http://localhost:5173,http://localhost:8080
SEMBRAR_AL_INICIAR=true

# Cuenta inicial. No deje la contraseña de ejemplo: el arranque la rechaza.
# Diccionario de cuenta pendiente de aprobación (P-09).
ADMIN_IDENTIFICADOR=admin
ADMIN_NOMBRE=Administrador inicial
ADMIN_CORREO=admin@example.com
ADMIN_CONTRASENA=cambiar-esto

# Sesión. Propuesta pendiente de aprobación (P-09): 30 minutos y 8 horas.
SESION_INACTIVIDAD_MINUTOS=30
SESION_DURACION_MAXIMA_HORAS=8

# Contraseña. Propuesta pendiente de aprobación (P-09).
CONTRASENA_LONGITUD_MINIMA=10
PROTEGER_ULTIMA_CUENTA_ADMIN=true

# Nombre visible en la interfaz. No hace falta recompilar el frontend: lo entrega /api/salud.
NOMBRE_PRODUCTO=GeoOportunidades
SUBTITULO_PRODUCTO=Inteligencia territorial

# Argon2id. Perfil propuesto, pendiente de aprobación (P-09). Cada hash lleva su sal.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16
