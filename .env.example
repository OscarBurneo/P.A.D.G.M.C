# Copie este archivo a .env y cambie los valores. No suba .env al repositorio.
# Los parámetros marcados como pendiente de aprobación son propuestas, no un acuerdo del cliente.

# Base de datos (P-07, entorno todavía no elegido)
POSTGRES_USER=padgmc
POSTGRES_PASSWORD=cambiar-esto
POSTGRES_DB=padgmc
BASE_DATOS_URL=postgresql+psycopg://padgmc:cambiar-esto@localhost:5432/padgmc

# desarrollo | prueba | produccion
# En produccion la cookie es Secure y el inicio de sesión exige HTTPS.
ENTORNO=desarrollo
CONFIAR_PROXY=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGENES=http://localhost:5173,http://localhost:8080
SEMBRAR_AL_INICIAR=true

# Cuenta inicial. No deje la contraseña de ejemplo: el arranque la rechaza.
# Diccionario de cuenta pendiente de aprobación (P-09).
ADMIN_IDENTIFICADOR=admin
ADMIN_NOMBRE=Administrador inicial
ADMIN_CORREO=admin@example.com
ADMIN_CONTRASENA=cambiar-esto

# Sesión. Propuesta pendiente de aprobación (P-09): 30 minutos y 8 horas.
SESION_INACTIVIDAD_MINUTOS=30
SESION_DURACION_MAXIMA_HORAS=8

# Contraseña. Propuesta pendiente de aprobación (P-09).
CONTRASENA_LONGITUD_MINIMA=10
PROTEGER_ULTIMA_CUENTA_ADMIN=true

# Nombre visible en la interfaz. No hace falta recompilar el frontend: lo entrega /api/salud.
NOMBRE_PRODUCTO=GeoOportunidades
SUBTITULO_PRODUCTO=Inteligencia territorial

# Directorio de los archivos importados. Vacío usa var/importaciones. El lote guarda el hash.
# IMPORTACIONES_DIRECTORIO=

# --- Docker: un solo equipo, la LAN y la recarga en caliente ---
# Nginx sustituye esta URL al arrancar el contenedor. No hace falta reconstruir.
# Un solo equipo: http://api:8000. Otro equipo, sin barra final: http://192.168.1.20:8000
# Es la dirección que usa Nginx, no el navegador.
API_UPSTREAM=http://api:8000

# Solo el servicio Vite (perfil vite). El navegador sigue pidiendo /api a Vite.
# API en el mismo anfitrión, publicada en 8000: http://host.docker.internal:8000
# API en otro equipo: http://192.168.1.20:8000
API_PROXY_TARGET=http://host.docker.internal:8000

# Sondeo de archivos del contenedor Vite. true en Docker Desktop (Windows y macOS):
# el bind mount no entrega eventos del disco. En Linux nativo puede ser false.
# El intervalo es en milisegundos.
CHOKIDAR_USEPOLLING=true
CHOKIDAR_INTERVAL=300

# Websocket de recarga. Vacío: el navegador usa la misma IP con la que abrió la página.
# Si no conecta, ponga la IP LAN del equipo frontend. No ponga localhost ni la IP del contenedor.
HMR_HOST=
HMR_CLIENT_PORT=5173
HMR_PROTOCOL=ws

# Vite 6 acepta una IP en el Host. true también acepta un nombre que no sea localhost.
# El valor lo lee el servidor de Vite; el perfil vite del Compose lo deja en true.
DEV_ALLOWED_HOSTS=true

# No apunte VITE_API_BASE a la IP de otro equipo, ni aquí ni en frontend/.env.
# El navegador tiene que llamar a /api en el mismo origen. Una base absoluta
# cruza de sitio: la cookie SameSite=lax no viaja por HTTP y el acceso queda en 401.
# Añadir ese origen a CORS_ORIGENES no hace que el navegador envíe la cookie.
# Déjela sin definir o vacía.
# VITE_API_BASE=

# Argon2id. Perfil propuesto, pendiente de aprobación (P-09). Cada hash lleva su sal.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2
ARGON2_HASH_LEN=32
ARGON2_SALT_LEN=16
